# Optional: enables the Gemini-powered wording layer. Keep this key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
# Set only if the web app is hosted on a different origin from this API.
FRONTEND_ORIGIN=
# Build-time frontend setting; leave blank when Express serves dist/.
VITE_API_BASE_URL=
